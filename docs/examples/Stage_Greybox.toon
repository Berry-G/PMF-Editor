# Prowl's Moving Factory — 스테이지 데이터 (pmf.stage/1)
# 이 파일은 PMF Editor 가 만들고 읽는다. 손으로 고쳐도 되지만 저장은 툴로 하는 편이 안전하다.
# 출처: 게임 프로젝트 2026-09-02 상태 — GreyboxMapData.cs(맵·경로) + Stage_Greybox.asset(수치)
#       씨앗값(GreyboxFactory)이 아니라 .asset 실측값이다. 씨앗값은 튜닝 전 숫자라 믿으면 안 된다.
schema: pmf.stage/1
name: Stage_Greybox

# --- 맵 --------------------------------------------------------------
# 문자: _ 빈칸(타일 없음 = 맵 밖, 런타임 Blocked)  . 땅  R 도로  B 배치가능  V 마을  W 벽  ~ 물
# 맨 위 행이 y = height-1 (화면에 보이는 그대로). 열 인덱스가 x.
# 벽을 '#' 로 쓰지 않는 이유: TOON 은 '#' 로 시작하는 줄을 주석으로 지운다.
map:
  width: 32
  height: 18
  origin[2]: -16,-9
  rows[18]{row}:
    ________________________________
    _BBBBBBBBBBBBBBBBBBBBBBBBBBBBBB_
    _BBBBBBBBBBBBBBBBBBBBBBBBBBWWWW_
    _BBBBBBBBBBBBBBBBBBBBBBBBBBWWWW_
    _BBBBBBBBBVBBBBBRRRRRRRRRBBWWWW_
    _BBBBBBBBBBBBBBBRBBBBBBBRBBBBBB_
    _BBBBBBBBBBBBBBBRBBBBBBBRBBBBBB_
    _BBBBBBBBBBBBBBBRBBBBBBBRBBBBBB_
    _RRRRRRRRBBBBBBBRBBBBBBBRBBVBBB_
    _BBBBBBBRBBBBBBBRBBBBBBBR~~~~~B_
    _BBBBBBBRBBBBBBBRBBBBBBBR~~~~~B_
    _BBBBBBBRBBBBBBBRBBBBBBBRRRRRRR_
    _BBBBBBBRBBBBBBBRBBBBBBBBBBBBBB_
    _BBBBBBBRRRRRRRRRBWWWWWBBBBBBBB_
    _BBBWWWBBBBBBBBBBBWWWWWBBBBBBBB_
    _BBBWWWBBBBBBBBBBBWWWWWBBBBBBBB_
    _BBBWWWBBBBBBBBBBBBBBBBBBBBBBBB_
    ________________________________

# --- 경로 --------------------------------------------------------------
# id 는 게임의 GameObject 이름이 된다. 버스트 트리거가 이 이름으로 정확히 매칭하므로 툴은 재번호하지 않는다.
# role: start(보호대상·모체 출발) / exit(탈출) / branch(도로 밖 분기, 아군 행군용) / waypoint(그 외)
# 코너 노드는 도로가 꺾이는 셀에 정확히 놓여야 한다 — 한 칸 어긋나면 직선 구간이 코너를 대각선으로 가로지른다.
path:
  nodes[16]{id,x,y,role}:
    N00_start,1,9,start
    N01,5,9,waypoint
    N02,8,9,waypoint
    N03,8,4,waypoint
    N04,11,4,waypoint
    N05,15,4,waypoint
    N06,16,4,waypoint
    N07,16,13,waypoint
    N08,18,13,waypoint
    N09,21,13,waypoint
    N10,24,13,waypoint
    N11,24,6,waypoint
    N12,27,6,waypoint
    N13_exit,30,6,exit
    B01_branch,12,8,branch
    B02_branch,20,10,branch
  # allowed: All | Escortee | Enemy | Ally, 여러 개면 '+' 로 잇는다. 양방향 엣지는 한 번만 적는다 (게임이 반대 방향을 만든다).
  # 지름길은 반드시 Escortee 만 — 적이 지나가면 지름길의 존재 이유가 사라진다 (ADR-0004).
  edges[18]{from,to,allowed,bidirectional,shortcut}:
    N00_start,N01,All,true,false
    N01,N02,All,true,false
    N02,N03,All,true,false
    N03,N04,All,true,false
    N04,N05,All,true,false
    N05,N06,All,true,false
    N06,N07,All,true,false
    N07,N08,All,true,false
    N08,N09,All,true,false
    N09,N10,All,true,false
    N10,N11,All,true,false
    N11,N12,All,true,false
    N12,N13_exit,All,true,false
    B01_branch,N04,All,true,false
    B01_branch,N05,All,true,false
    B02_branch,N08,All,true,false
    B02_branch,N09,All,true,false
    N05,N08,Escortee,true,true

# --- 스폰 --------------------------------------------------------------
# 리듬 = 묶음(volley) + 휴지(rest). 웨이브가 아니라 '호흡' 이다 (회의 결정 2).
# 사이클 = (volleyCount-1)*volleySpacing + restSeconds = 9.4초에 4마리 → 0.426 마리/초
spawn:
  volleyCount: 4
  volleySpacing: 0.4
  restSeconds: 8.2
  telegraphSeconds: 0.6
  # enemy 는 EnemyDefinition 에셋 이름. guid 는 넣지 않는다 — 기획자가 다룰 수 없고 에셋을 옮기면 깨진다.
  table[2]{enemy,weight}:
    Robot_Walker,70
    Robot_Scout,30
  # 진행도(0~1)별 적 체력 배율. Unity AnimationCurve 를 (t, 배율) 표로 편 것. 난이도와 곱하지 않는다.
  healthByProgress[2]{t,mul}:
    0,1
    1,1

# 버스트 = 모체가 추적을 멈추고 생산에 몰빵. 총량 보존 — 밀도만 바뀐다 (GDD §7).
burst:
  triggerNodeIds[2]: N06,N10
  duration: 10
  volleyCount: 6
  restSeconds: 2.5
  recoverySpeedMultiplier: 1.6
  recoverySeconds: 4

# --- 경제 --------------------------------------------------------------
# 난이도는 경제로만 조절한다. 적 체력·데미지에 배율을 걸지 않는다 (ADR-0018).
economy:
  startingResource: 150
  shortcutCost: 120
  difficulties[3]{difficulty,displayName,killReward,resourcePerSecond}:
    Easy,쉬움,4.5,3
    Normal,보통,4.5,0
    Hard,어려움,3,0

escortee:
  speed: 0.42
  maxHealth: 100

# 모체는 보호대상과 같은 start 노드에서 출발한다 (추격자 그림). 속도는 반드시 보호대상보다 느려야 한다.
mother:
  speed: 0.28
  spawnDelay: 5
  followsPath: true

presentation:
  uiSlowMotionScale: 0.1
  shotLineSeconds: 0.07
  magicMissileSpeed: 8
  hitFlashSeconds: 0.08
  debrisCount: 5
  debrisSeconds: 0.35
  healthBarHideWhenFull: true
  masterVolume: 1

# GDD §13 미결정 사항 실험 토글 (D-03, D-04)
toggles:
  alliesCanDieWhileMarching: false
  enemiesTargetAllies: false
